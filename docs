flowchart TD
    %% Swimlane Subgraphs
    subgraph Analyst ["Lane 1: Performance Analyst"]
        Start((Start: 48h Pre-Match)) --> A1["Ingest Recent Training & Match Telemetry [CREATE]"]
        A1 --> A2["Generate Squad Readiness Report in Power BI [RETRIEVE]"]
    end

    subgraph Coach ["Lane 2: Head Coach / Technical Staff"]
        A2 --> C1["Review Readiness Dashboard & Draft Match Lineup [RETRIEVE]"]
        C1 --> C2["Submit Proposed Lineup to System [CREATE]"]
        C4["Select Replacement Player"] --> C2
    end

    subgraph System ["Lane 3: Oracle PL/SQL Database System"]
        C2 --> S1["Retrieve Player Medical Status & Calculate Risk Score [RETRIEVE]"]
        S1 --> D1{"Is Player Status = 'Active/Injured'?"}
        D1 -- Yes --> S2["Trigger Blocks Insertion & Logs Denied Attempt [CREATE]"]
        S2 --> C4
        D1 -- No --> D2{"Is Risk Score > 75% (High Fatigue)?"}
        D2 -- No --> S3["Approve & Commit Player to Match Lineup [CREATE/UPDATE]"]
        S3 --> End((End: Final Squad Confirmed))
    end

    subgraph Medical ["Lane 4: Medical Department (Physiotherapist)"]
        D2 -- Yes --> M1["Evaluate Player Physical Condition [RETRIEVE]"]
        M1 --> D3{"Medically Fit to Play?"}
        D3 -- No --> M2["Update Status to 'Active/Injured' [UPDATE]"]
        M2 --> C4
        D3 -- Yes --> M3["Log Medical Clearance Override [UPDATE]"]
        M3 --> S3
    end
